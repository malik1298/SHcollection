# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g. https://your-brand.vercel.app).
APP_URL=""

# VITE_API_BASE: Custom API base URL (Default: '/api' for same-origin Vercel deployment)
# VITE_API_BASE="/api"

# SESSION_SECRET: Secret key for signing server-side auth sessions (Optional)
SESSION_SECRET="sh-collection-luxury-bridal-secret-2026"

# PORT: Local server port (Default: 3000 for local dev server, ignored on Vercel Serverless)
PORT=3000

# DISABLE_HMR: Set to 'true' in preview iframe environments to disable HMR WebSocket
# DISABLE_HMR=false
